# TMDB API read access token (v4 auth "Bearer" token).
# Get one at https://www.themoviedb.org/settings/api
#
# NOTE: this is a *client-side* app, so any value here is shipped to the browser
# and is publicly readable. TMDB read tokens are designed for that; never put a
# write token or any other secret in a VITE_-prefixed variable.
VITE_TMDB_TOKEN=your_tmdb_v4_read_access_token

# Absolute origin of the deployed site. Used for canonical URLs, Open Graph
# metadata and sitemap.xml generation.
VITE_SITE_URL=https://movies-app.vercel.app
